// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  RIDER
  CAPTAIN
  ADMIN
}

enum RideStatus {
  PENDING
  ACCEPTED
  ARRIVED
  ONGOING
  COMPLETED
  CANCELLED
}

enum VehicleType {
  BIKE
  CAR
  AUTO
}

// Vehicle class for premium rides
enum VehicleClass {
  ECONOMY // Basic vehicles (Uber Go)
  COMFORT // Mid-range (Uber Premier)
  PREMIUM // Luxury vehicles (Uber Black)
  XL // SUVs and larger vehicles
}

// Ride type for solo vs shared rides
enum RideType {
  SOLO // Regular single-rider trip
  SHARED // Pool/shared ride
}

// Payment status enum
enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

// Payment mode enum - how rider wants to pay
enum PaymentMode {
  CASH // Pay cash to captain
  UPI // Pay via UPI (captain shows QR or shares number)
  IN_APP // Pay through app (Razorpay)
}

enum ReviewType {
  RIDER_TO_CAPTAIN
  CAPTAIN_TO_RIDER
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

// Bidding status for negotiation mode
enum BidStatus {
  PENDING // Waiting for captain response
  ACCEPTED // Captain accepted rider's price
  COUNTERED // Captain made counter-offer
  REJECTED // Bid rejected/expired
  SELECTED // Rider selected this bid
}

model Review {
  id         Int        @id @default(autoincrement())
  ride       Ride       @relation("RideReviews", fields: [rideId], references: [id])
  rideId     Int
  reviewer   User       @relation("Reviewer", fields: [reviewerId], references: [id])
  reviewerId Int
  reviewee   User       @relation("Reviewee", fields: [revieweeId], references: [id])
  revieweeId Int
  rating     Int
  comment    String?
  type       ReviewType
  createdAt  DateTime   @default(now())
}

model RideLocationLog {
  id     Int  @id @default(autoincrement())
  ride   Ride @relation(fields: [rideId], references: [id])
  rideId Int

  latitude  Float
  longitude Float

  timestamp DateTime @default(now())
}

// Chat Messages for real-time chat during rides
model ChatMessage {
  id        Int      @id @default(autoincrement())
  ride      Ride     @relation(fields: [rideId], references: [id])
  rideId    Int
  sender    User     @relation(fields: [senderId], references: [id])
  senderId  Int
  message   String
  createdAt DateTime @default(now())
}

model Ride {
  id Int @id @default(autoincrement())

  pickupAddress String
  pickupLat     Float
  pickupLng     Float

  dropoffAddress String
  dropoffLat     Float
  dropoffLng     Float

  rider   User @relation("RiderRides", fields: [riderId], references: [id])
  riderId Int

  captain   CaptainProfile? @relation("CaptainRides", fields: [captainId], references: [id])
  captainId Int?

  locationLogs RideLocationLog[]
  reviews      Review[]          @relation("RideReviews")
  chatMessages ChatMessage[]
  sosAlerts    SOSAlert[]
  shareLinks   RideShareLink[]
  payment      Payment?          @relation("RidePayment")
  bids         RideBid[]         @relation("RideBids")

  status RideStatus @default(PENDING)

  vehicleType  VehicleType
  vehicleClass VehicleClass @default(ECONOMY)

  // Ride type for solo vs shared
  rideType        RideType @default(SOLO)
  availableSeats  Int      @default(0) // For shared rides: remaining seats
  parentRideId    Int? // For shared rides: link to original ride
  parentRide      Ride?    @relation("SharedRides", fields: [parentRideId], references: [id])
  sharedRides     Ride[]   @relation("SharedRides")
  sharingDiscount Float    @default(0) // Discount percentage for shared rides

  // Bidding/Negotiation mode
  isBiddingEnabled Boolean @default(false)
  baseOfferPrice   Float? // Rider's initial offer
  finalAgreedPrice Float? // Final negotiated price

  fare            Float?
  surgeMultiplier Float  @default(1.0) // Surge pricing multiplier

  // Payment tracking
  paymentMode        PaymentMode   @default(CASH) // How rider wants to pay
  paymentStatus      PaymentStatus @default(PENDING) // Current payment state
  paymentCollectedAt DateTime? // When payment was collected/confirmed

  // New fields for production-grade ride data
  estimatedDistance Float? // Distance in km from Mapbox
  estimatedDuration Float? // Duration in minutes from Mapbox
  routeGeometry     String? @db.Text // GeoJSON geometry from Mapbox for route display

  otp String?

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Bidding model for negotiation mode (like InDrive)
model RideBid {
  id     Int  @id @default(autoincrement())
  ride   Ride @relation("RideBids", fields: [rideId], references: [id])
  rideId Int

  captain   CaptainProfile @relation("CaptainBids", fields: [captainId], references: [id])
  captainId Int

  offerAmount Float // Captain's counter-offer (or accepted amount)
  status      BidStatus @default(PENDING)

  // ETA info for rider to see
  estimatedArrival Int? // Minutes to pickup

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([rideId, captainId]) // One bid per captain per ride
}

model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  password String?
  fullName String
  phone    String  @unique
  role     Role    @default(RIDER)

  // Stripe customer ID for payment processing
  stripeCustomerId String?

  // Firebase Cloud Messaging token for push notifications
  fcmToken String?

  //Relations
  riderProfile   RiderProfile?
  captainProfile CaptainProfile?

  ridesAsRider Ride[]        @relation("RiderRides")
  chatMessages ChatMessage[]
  sosAlerts    SOSAlert[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  reviews         Review[] @relation("Reviewer")
  reviewsReceived Review[] @relation("Reviewee")
}

model RiderProfile {
  id     Int  @id @default(autoincrement())
  user   User @relation(fields: [userId], references: [id])
  userId Int  @unique

  // Saved addresses for one-tap booking
  homeAddress    String?
  homeAddressLat Float?
  homeAddressLng Float?
  workAddress    String?
  workAddressLat Float?
  workAddressLng Float?

  // Emergency contacts (stored as JSON array)
  emergencyContacts String? @db.Text // JSON: [{name, phone, relation}]

  rating     Float @default(5.0)
  totalRides Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// SOS Alerts for emergency situations
model SOSAlert {
  id     Int  @id @default(autoincrement())
  ride   Ride @relation(fields: [rideId], references: [id])
  rideId Int

  user   User @relation(fields: [userId], references: [id])
  userId Int

  latitude  Float
  longitude Float

  status     String    @default("ACTIVE") // ACTIVE, RESOLVED, FALSE_ALARM
  resolvedAt DateTime?
  resolvedBy Int? // Admin who resolved it

  createdAt DateTime @default(now())
}

// Ride Share Links for sharing live tracking
model RideShareLink {
  id     Int  @id @default(autoincrement())
  ride   Ride @relation(fields: [rideId], references: [id])
  rideId Int

  token     String   @unique // UUID token for public access
  expiresAt DateTime
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
}

model CaptainProfile {
  id     Int  @id @default(autoincrement())
  user   User @relation(fields: [userId], references: [id])
  userId Int  @unique

  vehicleType   VehicleType
  vehicleClass  VehicleClass @default(ECONOMY) // Vehicle class for premium rides
  vehicleNumber String
  vehicleModel  String
  vehicleColor  String

  isAvailable Boolean @default(true)
  isOnline    Boolean @default(false)
  isVerified  Boolean @default(false) // Admin verification status

  lastLat Float?
  lastLng Float?

  rating        Float @default(5.0)
  totalRides    Int   @default(0)
  totalEarnings Float @default(0.0)

  // Stripe connected account for payouts
  stripeAccountId       String?
  stripeAccountVerified Boolean @default(false)

  // Wallet balance (pending withdrawals)
  walletBalance Float @default(0.0)

  // OCR extracted document data
  licenseNumber  String?
  licenseExpiry  DateTime?
  rcNumber       String?
  rcExpiry       DateTime?
  ownerName      String?
  lastVerifiedAt DateTime? // Last external verification check

  // Captain documents
  documents CaptainDocument[]

  ridesGiven  Ride[]       @relation("CaptainRides")
  shifts      Shift[]
  withdrawals Withdrawal[] @relation("CaptainWithdrawals")
  bids        RideBid[]    @relation("CaptainBids")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Captain Documents for onboarding simulation
model CaptainDocument {
  id        Int            @id @default(autoincrement())
  captain   CaptainProfile @relation(fields: [captainId], references: [id])
  captainId Int

  documentType String // LICENSE, INSURANCE, RC, AADHAR, PAN
  documentUrl  String
  status       DocumentStatus @default(PENDING)

  // OCR extracted data
  extractedText   String?   @db.Text // Raw extracted text from OCR
  extractedNumber String? // Extracted document number
  extractedExpiry DateTime? // Extracted expiry date
  extractedName   String? // Extracted name

  // External verification result
  externalVerified     Boolean   @default(false)
  externalVerifyStatus String? // ACTIVE, SUSPENDED, EXPIRED, etc.
  lastExternalCheck    DateTime?

  uploadedAt DateTime  @default(now())
  verifiedAt DateTime?
}

model Shift {
  id        Int            @id @default(autoincrement())
  captain   CaptainProfile @relation(fields: [captainId], references: [id])
  captainId Int

  startTime DateTime
  endTime   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id     Int  @id @default(autoincrement())
  ride   Ride @relation("RidePayment", fields: [rideId], references: [id])
  rideId Int  @unique

  // Stripe payment intent details
  stripePaymentIntentId String @unique
  stripeCustomerId      String

  amount   Float // Amount in currency units
  currency String @default("inr")

  status PaymentStatus @default(PENDING)

  // Payment timestamps
  authorizedAt DateTime?
  capturedAt   DateTime?
  refundedAt   DateTime?

  // Metadata
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Withdrawal model for captain payouts
model Withdrawal {
  id        Int            @id @default(autoincrement())
  captain   CaptainProfile @relation("CaptainWithdrawals", fields: [captainId], references: [id])
  captainId Int

  amount   Float
  currency String @default("inr")

  // Stripe transfer details
  stripeTransferId String? @unique

  status String @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED

  processedAt   DateTime?
  failedAt      DateTime?
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
